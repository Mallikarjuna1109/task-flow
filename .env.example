NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public

DATABASE_URL_TEST=postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

BCRYPT_SALT_ROUNDS=12

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

EMAIL_MAX_RETRIES=3
EMAIL_RATE_LIMIT_MAX=50
EMAIL_RATE_LIMIT_DURATION_MS=60000

CORS_ORIGIN=*

LOG_LEVEL=info
