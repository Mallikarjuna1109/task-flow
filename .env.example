# ---------------------------------------------------------------------------
# TaskFlow environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma (API + Worker + migrations)
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public

# Separate database used only by the automated test suite (see README > Testing)
DATABASE_URL_TEST=postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public

# Redis connection string used by BullMQ (API enqueues, Worker consumes)
REDIS_URL=redis://localhost:6379

# JWT secrets - use long, random, distinct values in real deployments
# e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# bcrypt work factor, must be >= 12 per spec
BCRYPT_SALT_ROUNDS=12

# Auth endpoint rate limit
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Email worker
EMAIL_MAX_RETRIES=3
EMAIL_RATE_LIMIT_MAX=50
EMAIL_RATE_LIMIT_DURATION_MS=60000

# CORS
CORS_ORIGIN=*

LOG_LEVEL=info
